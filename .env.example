# Local dev (SQLite) - functioneaza imediat, fara setup suplimentar
DATABASE_URL="file:./dev.db"

# Parola pentru /admin - alege ceva puternic inainte sa mergi live
ADMIN_PASSWORD="schimba-asta-acum"

# Stripe - ia-le din dashboard.stripe.com dupa ce iti creezi contul
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Productie (exemplu Postgres, cand esti gata sa mergi live):
